# Copie este arquivo para .env.local e preencha.
# Tudo é opcional: sem nenhuma chave o app roda em modo local + demonstração.

# ── Supabase (login, cadastro e dados na nuvem) ─────────────────────────
# Project Settings → API Keys. Sem estas duas, o app roda em MODO LOCAL (sem login).
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable key" (sb_publishable_...). Projetos antigos: use a "anon key".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Captcha Cloudflare Turnstile (opcional, grátis). Só preencha depois de ligar o captcha no
# Supabase (Authentication → Attack Protection) com a SECRET key do Turnstile. Veja SECURITY.md.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Chave SECRETA do Supabase (Project Settings → API Keys → Secret keys, sb_secret_...).
# Só no servidor: grava a assinatura que vem do Stripe e devolve créditos de busca que falharam.
# NUNCA coloque NEXT_PUBLIC_ na frente. Sem ela, os pagamentos ficam desligados.
SUPABASE_SECRET_KEY=

# ── Planos e pagamentos (Stripe) ────────────────────────────────────────
# Sem estas variáveis, todo mundo fica no plano Grátis (os limites continuam valendo).
# Developers → API keys → Secret key (sk_test_... no modo de teste, sk_live_... em produção).
STRIPE_SECRET_KEY=
# Developers → Webhooks → endpoint → Signing secret (whsec_...). No PC: `stripe listen` mostra um.
STRIPE_WEBHOOK_SECRET=
# Product catalog → produto → preço mensal → copie o ID (price_...). Teste e produção têm IDs diferentes.
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCIA=
# Endereço público do app (volta do checkout). Em produção: https://seudominio.com.br
APP_URL=http://localhost:3000

# Cron da Vercel (/api/cron/keepalive, 1x por dia): evita que o Supabase grátis pause.
# Gere um texto aleatório longo (ex.: `openssl rand -hex 32`) e cadastre na Vercel.
CRON_SECRET=

# ── Limites de uso por usuário (opcional; padrão entre parênteses) ──────
# RATE_LIMIT_SEARCH_PER_HOUR=30
# RATE_LIMIT_SEARCH_PER_DAY=150
# RATE_LIMIT_ANALYSIS_PER_HOUR=60

# ── Google (só no servidor, nunca vão para o navegador) ────────────────
# Google Cloud Console → APIs e serviços → ative "Places API (New)" → Credenciais → Criar chave.
# Restrinja a chave à "Places API (New)". Exige faturamento ativo no Google Cloud.
# Sem esta chave, a busca roda em MODO DEMONSTRAÇÃO (empresas fictícias).
GOOGLE_PLACES_API_KEY=

# Fase 2 · análise de sites (opcional). Sem chave funciona, mas com poucas análises por dia.
# Google Cloud → ative "PageSpeed Insights API" → Credenciais → Criar chave.
PAGESPEED_API_KEY=

# Fase 4 (ainda não usada)
OPENAI_API_KEY=

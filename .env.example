# Copie este arquivo para .env.local e preencha.
# Tudo é opcional: sem nenhuma chave o app roda em modo local + demonstração.

# ── Supabase (login, cadastro e dados na nuvem) ─────────────────────────
# Project Settings → API Keys. Sem estas duas, o app roda em MODO LOCAL (sem login).
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable key" (sb_publishable_...). Projetos antigos: use a "anon key".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Google (só no servidor, nunca vão para o navegador) ────────────────
# Google Cloud Console → APIs e serviços → ative "Places API (New)" → Credenciais → Criar chave.
# Restrinja a chave à "Places API (New)". Exige faturamento ativo no Google Cloud.
# Sem esta chave, a busca roda em MODO DEMONSTRAÇÃO (empresas fictícias).
GOOGLE_PLACES_API_KEY=

# Fase 2 · análise de sites (opcional). Sem chave funciona, mas com poucas análises por dia.
# Google Cloud → ative "PageSpeed Insights API" → Credenciais → Criar chave.
PAGESPEED_API_KEY=

# Fase 4 (ainda não usada)
OPENAI_API_KEY=
